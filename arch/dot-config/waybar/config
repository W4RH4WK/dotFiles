{
    "position": "bottom",
    "height": 42,
    "spacing": 42,
    "modules-left": [
		"hyprland/workspaces",
        "river/tags",
        "mpd",
    ],
    "modules-center": [
    ],
    "modules-right": [
        "bluetooth",
        "network#eth",
        "network#wifi",
        "tray",
        "pulseaudio",
        "power-profiles-daemon",
        "battery",
        "clock",
    ],
	"hyprland/workspaces": {
		"format": "{icon}",
		"format-icons": {
			"1": "󰈹",
			"6": "󰝚",
			"7": "󰺻",
			"8": "󰭹",
			"9": "󰍹",
			"scratch": "󰎚"
		},
		"persistent-workspaces": {
			"*": [1, 2, 3, 4, 5, 6, 7, 8, 9],
		},
		"show-special": true
	},
    "river/tags": {
        "tag-labels": ["󰈹", "2", "3", "4", "5", "6", "󰺻", "", "󰭹"],
    },
    "mpd": {
        "format": "{stateIcon} {artist} - {title}",
        "format-stopped": " Stopped",
        "unknown-tag": "N/A",
        "interval": 5,
        "state-icons": {
            "playing": "",
            "paused": "",
        },
        "tooltip": false,
        "on-click": "myshell media",
    },
    "tray": {
        "icon-size": 24,
        "spacing": 24,
        "reverse-direction": true,
    },
    "clock": {
        "tooltip-format": "{:%Y-%m-%d %a}",
        "on-click": "myshell cal",
        "on-click-right": "myshell top",
    },
    "battery": {
        "states": {
            "warning": 20,
            "critical": 10,
        },
        "format": "{icon}   {capacity}%",
        "format-full": "{icon}   {capacity}%",
        "format-charging": "󰚥   {capacity}%",
        "format-plugged": "󰚥   {capacity}%",
        "format-alt": "{icon}   {time}",
        "format-time": "{H}h{M}m",
        "format-icons": ["", "", "", "", ""],
        "tooltip": false,
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "format-icons": {
        "default": "󰓅",
        "performance": "󰓅",
        "balanced": "󰾅",
        "power-saver": "󰾆",
      },
      "tooltip": true,
      "tooltip-format": "{profile} ({driver})",
    },
    "bluetooth": {
        "format-connected": " {device_alias}",
        "format-connected-battery": " {device_alias}",
        "tooltip-format-connected-battery": "Battery {device_battery_percentage}%",
        "on-click": "myshell bluetooth",
    },
    "network#eth": {
        "interface": "eth0",
        "format": "󰈀   {ipaddr}",
        "format-linked": "󰈀   {ifname}",
        "format-disconnected": "",
        "format-disabled": "",
        "tooltip-format": "{ifname}",
        "on-click": "myshell network",
    },
    "network#wifi": {
        "interface": "wlan0",
        "format": "   {ipaddr}",
        "format-disconnected": "   {ifname}",
        "format-disabled": "   {ifname}",
        "tooltip-format": "{ifname}",
        "on-click": "myshell network",
    },
    "pulseaudio": {
        "format": "{format_source} {icon}   {volume}%",
        "format-muted": "{format_source}  ",
        "format-bluetooth": " {format_source} {icon}   {volume}%",
        "format-bluetooth-muted": " {format_source}  ",
        "format-source": "",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "",
            "portable": "",
            "car": "󰄋",
            "default": ["", "", ""],
        },
        "on-click": "myshell audio",
        "on-click-right": "myshell audio_mute",
    }
}
